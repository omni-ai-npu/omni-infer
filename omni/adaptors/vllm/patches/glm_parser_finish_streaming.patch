+    @staticmethod
+    def _delta_function_name(function):
+        if function is None:
+            return None
+        if isinstance(function, dict):
+            return function.get("name")
+        return function.name
+
+    @staticmethod
+    def _delta_function_arguments(function):
+        if function is None:
+            return None
+        if isinstance(function, dict):
+            return function.get("arguments")
+        return function.arguments
+
+    @staticmethod
+    def _set_delta_function_name(function, name):
+        if isinstance(function, dict):
+            function["name"] = name
+        else:
+            function.name = name
+
+    @staticmethod
+    def _append_delta_function_arguments(function, arguments):
+        if isinstance(function, dict):
+            function["arguments"] = (function.get("arguments")
+                                        or "") + arguments
+        elif function.arguments is None:
+            function.arguments = arguments
+        else:
+            function.arguments += arguments
+
+    @classmethod
+    def _merge_tool_call_deltas(
+            cls, tool_calls: list[DeltaToolCall]) -> list[DeltaToolCall]:
+        merged: dict[int, DeltaToolCall] = {}
+        for tool_call in tool_calls:
+            existing = merged.get(tool_call.index)
+            if existing is None:
+                merged[tool_call.index] = tool_call
+                continue
+            if tool_call.id is not None and existing.id is None:
+                existing.id = tool_call.id
+            if tool_call.type is not None and existing.type is None:
+                existing.type = tool_call.type
+            if tool_call.function is None:
+                continue
+            if existing.function is None:
+                existing.function = tool_call.function
+                continue
+            name = cls._delta_function_name(tool_call.function)
+            if name is not None and cls._delta_function_name(
+                    existing.function) is None:
+                cls._set_delta_function_name(existing.function, name)
+            arguments = cls._delta_function_arguments(tool_call.function)
+            if arguments is not None:
+                cls._append_delta_function_arguments(existing.function, arguments)
+        return list(merged.values())
+
+    @classmethod
+    def _merge_delta_message(cls, delta_message, extra_delta_message):
+        if extra_delta_message is None:
+            return delta_message
+        if delta_message is None:
+            return extra_delta_message
+        if extra_delta_message.content:
+            delta_message.content = (delta_message.content
+                                     or "") + extra_delta_message.content
+        if extra_delta_message.reasoning_content:
+            delta_message.reasoning_content = (
+                delta_message.reasoning_content
+                or "") + extra_delta_message.reasoning_content
+        if extra_delta_message.tool_calls:
+            if delta_message.tool_calls is None:
+                delta_message.tool_calls = []
+            delta_message.tool_calls.extend(extra_delta_message.tool_calls)
+            if len(delta_message.tool_calls) > 1:
+                delta_message.tool_calls = cls._merge_tool_call_deltas(
+                    delta_message.tool_calls)
+        return delta_message
+
