+                if request.reasoning_effort is not None:
+                    # omni: derive enable_thinking from reasoning_effort so the
+                    # field actually takes effect for models (e.g. GLM) whose
+                    # reasoning parser reads the enable_thinking/thinking bool
+                    # rather than reasoning_effort directly. "none" turns
+                    # thinking OFF; low/medium/high keep it ON. Mirrors the
+                    # latest vLLM behavior. Only set when the client hasn't.
+                    # NOTE: this runs for all non-harmony models (GLM, DeepSeek,
+                    # Qwen, ...); the outer `not self.use_harmony` guard already
+                    # excludes gpt-oss, which uses the Harmony path below.
+                    if "enable_thinking" not in (request.chat_template_kwargs or {}):
+                        request.chat_template_kwargs = (
+                            request.chat_template_kwargs or {}) | {
+                            "enable_thinking": request.reasoning_effort != "none"
                         }
+                    # Pass the effort as a plain STRING into chat_template_kwargs
+                    # so the Jinja template can compare `reasoning_effort == 'high'`
+                    # (chat_template.jinja line 2). Do NOT use the ReasoningEffort
+                    # enum here - the template expects a string, and the enum would
+                    # make the `== 'high'` check always False (everything -> "Max").
+                    # The enum is only needed by the Harmony (gpt-oss) path below.
+                    if request.reasoning_effort != "none":
+                        request.chat_template_kwargs = (
+                            request.chat_template_kwargs or {}) | {
