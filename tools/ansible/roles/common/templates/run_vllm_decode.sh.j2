{% set profile = resolved_run_server_decode_profile -%}
{% set common_profile = run_server_common_profile_defaults | combine(run_server_common_profile, recursive=true) -%}
#!/bin/bash

. ~/.bashrc
KV_PARALLEL_SIZE=$((OMNI_PD_PREFILL_POD_NUM + 1))
export DECODE_SERVER_LIST={{ ascend_rt_visible_devices | quote }}
export NUM_SERVERS={{ ascend_rt_visible_devices.split(',') | length }}
unset https_proxy
unset http_proxy
unset proxy

{{ profile.prepare_commands }}

dp=$(echo -n "$DECODE_DATA_PARALLEL_SIZE" | tr -cd ',' | wc -c)
((dp++))
declare -A config_dict=(
    {% for key, value in server_offset_dict.items() %}
    [{{ key }}]={{ value }}{% if not loop.last %} {% endif %}
    {% endfor %}
)

{% if common_profile.kv_connector == "LMCacheConnectorV1" -%}
export MOONCAKE_CONFIG_PATH={{ ansible_env.SCRIPTS_PATH }}/mooncake_config.json
export LMCACHE_CONFIG_FILE={{ ansible_env.SCRIPTS_PATH }}/lmcache_mooncake_config.yml
{% endif %}

cd {{ profile.workdir }}
bash {{ profile.workdir }}/{{ profile.runner }} \
  --local-decode-server-ip-list "$SERVER_IP_LIST" \
  --global-decode-server-ip-list "$SERVER_IP_LIST" \
  --prefill-pod-num ${OMNI_PD_PREFILL_POD_NUM} \
  --gloo-socket-ifname ${SOCKET_IFNAME} \
  --tp-socket-ifname ${SOCKET_IFNAME} \
  --num-servers ${NUM_SERVERS} \
  --num-dp ${dp} \
  --server-offset ${config_dict[$HOST]:-0} \
  --model-path {{ model_path | quote }} \
  --master-ip ${HOST_IP} \
  --role "decode" \
  --kv-role "kv_consumer" \
  --master-port ${MASTER_PORT} \
  --base-api-port ${API_PORT} \
  --kv-rank ${OMNI_PD_PREFILL_POD_NUM} \
  --kv-engine-id ${OMNI_PD_PREFILL_POD_NUM} \
  --kv-parallel-size ${KV_PARALLEL_SIZE} \
  --kv-connector {{ common_profile.kv_connector }} \
{% for argument in profile.args -%}
{{ '  ' }}{{ argument }} \
{% endfor -%}
{{ '  ' }}--log-dir "${LOG_PATH}/{{ inventory_hostname }}" > ${LOG_PATH}/{{ inventory_hostname }}/run_decode.log 2>&1 &
